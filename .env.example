# Copy to .env (or run `make init`, which also generates the keys below).

# Fernet key that encrypts stored database passwords. Keep it secret and stable:
# changing it makes every saved connection password unreadable.
CREDENTIALS_KEY=

APP_DB_PASSWORD=
SCRATCH_DB_PASSWORD=
ORACLE_SANDBOX_SYS_PASSWORD=

# "thick" uses the bundled Oracle Instant Client; needed if your Oracle server
# enforces Native Network Encryption.
ORACLE_CLIENT_MODE=thin
TARGET_PG_VERSION=18

# Claude review of Oracle/PostgreSQL pairs (Scenario 2). Only source code is sent.
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace: the workspace ID (wrkspc_...) from the Claude Console.
ANTHROPIC_WORKSPACE_ID=
REVIEW_MODEL=claude-opus-5-5
REVIEW_EFFORT=high
REVIEW_CONCURRENCY=4
# Schema explorer performance review: objects per run, objects and source characters per request.
PERF_REVIEW_MAX_OBJECTS=300
PERF_REVIEW_BATCH_OBJECTS=8
PERF_REVIEW_BATCH_CHARS=60000
# Per-schema limit for Ora2Pg's cost estimate during a scan (seconds). Large schemas can need 30-60 min.
ORA2PG_REPORT_TIMEOUT_SECONDS=900
